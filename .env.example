# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Telegram User ID администраторов бота через запятую (опционально, для /subscribe и /unsubscribe в группах)
# Получить свой ID можно у @userinfobot
ADMIN_USER_IDS=123456789

# Время ежедневного уведомления (HH:MM, часовой пояс Europe/Moscow)
NOTIFICATION_TIME=19:00

# Автоматически отправлять оповещения об изменениях в расписании (true/false)
AUTO_DIFF_NOTIFY=true

